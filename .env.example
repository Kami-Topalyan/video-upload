# Copy to .env — docker compose reads it automatically.

# ---- Required ----
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Signs login tokens. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# ---- Optional ----
# Host port for the web UI (production stack)
WEB_PORT=8080
APIPORT=4000

# Per-file upload limit enforced by the API, in MB.
# nginx accepts bodies up to 100m by default; raise MAX_BODY_SIZE on the web service if you go higher.
MAX_FILE_SIZE_MB=50

# ---- Only when running the API outside Docker (cd backend && npm run dev) ----
# The compose files set these for you.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=app
# PGUSER=app
# PGPASSWORD=<same as POSTGRES_PASSWORD>
# UPLOAD_DIR=./uploads
